{
  "name": "chekushka",
  "productName": "Чекушка",
  "version": "1.5.0",
  "description": "ЧЕКУШКА-МЕЛЛ: МОЙ МИЛЫЙ ПИТОМЕЦ — пиксельный питомец для рабочего стола macOS и Windows",
  "main": "main.js",
  "author": "mikhail-krainev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "screenshots": "electron . --screenshots ../docs/screenshots",
    "predist:mac": "npm install --no-save --force --no-audit --no-fund @koromix/koffi-darwin-arm64@3.3.4 @koromix/koffi-darwin-x64@3.3.4",
    "dist:mac": "electron-builder --mac --arm64 --publish never && electron-builder --mac --x64 --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist": "electron-builder",
    "showcase": "electron showcase.js ../docs/screenshots",
    "showcase:desktop": "electron showcase.js ../docs/screenshots --desktop"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mikhailkrainev.chekushka",
    "productName": "Chekushka",
    "artifactName": "Chekushka-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "stationary.js",
      "watcher.js",
      "settings.js",
      "desktop.js",
      "cursor.js",
      "screenshots.js",
      "updater/**/*",
      "quit/**/*",
      "ui/**/*",
      "voice/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "pkg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "ЧЕКУШКА-МЕЛЛ: МОЙ МИЛЫЙ ПИТОМЕЦ двигает папки на рабочем столе через Finder и возвращает их на место.",
        "NSMicrophoneUsageDescription": "ЧЕКУШКА-МЕЛЛ слушает микрофон, только когда ты включаешь его кнопкой рядом с ним, и отвечает на твои фразы. Речь распознаётся на компьютере и никуда не отправляется.",
        "CFBundleDisplayName": "ЧЕКУШКА-МЕЛЛ: МОЙ МИЛЫЙ ПИТОМЕЦ"
      },
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mikhail-krainev",
        "repo": "my-little-chekushka"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "koffi": "3.3.4",
    "vosk-browser": "0.0.8"
  }
}
