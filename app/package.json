{
  "name": "chekushka",
  "productName": "Чекушка",
  "version": "1.1.1",
  "description": "Desktop pet «Чекушка Мировая №67» for macOS and Windows",
  "main": "main.js",
  "author": "mikhail-krainev",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "screenshots": "electron . --screenshots ../docs/screenshots",
    "dist:mac": "electron-builder --mac --arm64 --publish never && electron-builder --mac --x64 --publish never",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mikhailkrainev.chekushka",
    "productName": "Chekushka",
    "artifactName": "Chekushka-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "watcher.js",
      "screenshots.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "pkg"
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": false
    }
  }
}
